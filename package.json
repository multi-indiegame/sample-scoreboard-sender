{
  "name": "@multi-indiegame/sample-scoreboard-sender",
  "private": true,
  "version": "0.1.0",
  "description": "",
  "scripts": {
    "postinstall": "npm run build",
    "build": "rimraf ./script && tsc && akashic scan asset script",
    "update": "akashic scan asset && akashic scan globalScripts",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "start": "akashic sandbox . --target-service nicolive:multi",
    "start:multi": "akashic serve . --target-service nicolive:multi",
    "export-zip": "rimraf game.zip && akashic export zip -o game.zip -s nicolive",
    "test": "jest",
    "relock": "find node_modules/@akashic -name npm-shrinkwrap.json -delete && rimraf package-lock.json && npm install --package-lock-only && npm install"
  },
  "author": "multi-indiegame",
  "license": "MIT",
  "devDependencies": {
    "@akashic/akashic-cli": "^3.0.28",
    "@akashic/akashic-engine": "^3.21.3",
    "@akashic/headless-akashic": "^4.9.0",
    "@multi-indiegame/akashic-scoreboard-serve": "^1.0.0",
    "@stylistic/eslint-plugin-ts": "^4.0.0",
    "@types/jest": "^29.1.0",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "eslint": "^9.12.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^17.0.0",
    "jest": "^29.1.1",
    "rimraf": "^6.0.0",
    "ts-jest": "^29.0.3",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@akashic-extension/resolve-player-info": "^1.3.0",
    "@multi-indiegame/akashic-scoreboard": "^1.0.0"
  },
  "overrides": {
    "uuid": "11.1.1",
    "ws": "8.22.0",
    "tar": "7.5.22",
    "qs": "6.16.0",
    "rollup": "4.63.5",
    "socket.io-parser": "4.2.7",
    "minimatch": "10.2.6",
    "lodash": "4.18.1",
    "file-type": "22.1.1",
    "image-size": "1.2.1",
    "music-metadata": "11.16.1",
    "decode-uri-component": "0.5.0",
    "cookie": "0.7.2",
    "engine.io": "6.6.11",
    "@babel/core": "7.29.7"
  }
}
