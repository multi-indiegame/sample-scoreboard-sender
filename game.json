{
	"width": 1280,
	"height": 720,
	"fps": 30,
	"main": "./script/_bootstrap.js",
	"assets": {
		"main": {
			"type": "script",
			"path": "script/main.js",
			"global": true
		},
		"_bootstrap": {
			"type": "script",
			"path": "script/_bootstrap.js",
			"global": true
		},
		"parameterObject": {
			"type": "script",
			"path": "script/parameterObject.js",
			"global": true
		},
		"assets/images/entry.png": {
			"type": "image",
			"path": "assets/images/entry.png",
			"width": 200,
			"height": 40
		},
		"layout": {
			"type": "script",
			"path": "script/layout.js",
			"global": true
		},
		"records": {
			"type": "script",
			"path": "script/records.js",
			"global": true
		},
		"consent": {
			"type": "script",
			"path": "script/consent.js",
			"global": true
		}
	},
	"environment": {
		"sandbox-runtime": "3",
		"nicolive": {
			"supportedModes": [
				"multi"
			]
		},
		"external": {
			"scoreboard": "0",
			"coeLimited": "0"
		}
	},
	"globalScripts": [
		"node_modules/@akashic-extension/akashic-hover-plugin/lib/Converter.js",
		"node_modules/@akashic-extension/akashic-hover-plugin/lib/HoverPlugin.js",
		"node_modules/@akashic-extension/akashic-hover-plugin/lib/index.js",
		"node_modules/@akashic-extension/resolve-player-info/lib/FallbackDialog.js",
		"node_modules/@akashic-extension/resolve-player-info/lib/index.js",
		"node_modules/@multi-indiegame/akashic-scoreboard/lib/index.js",
		"node_modules/@multi-indiegame/akashic-scoreboard/lib/protocol.js"
	],
	"moduleMainScripts": {
		"@multi-indiegame/akashic-scoreboard": "node_modules/@multi-indiegame/akashic-scoreboard/lib/index.js",
		"@akashic-extension/resolve-player-info": "node_modules/@akashic-extension/resolve-player-info/lib/index.js",
		"@akashic-extension/akashic-hover-plugin": "node_modules/@akashic-extension/akashic-hover-plugin/lib/index.js"
	}
}